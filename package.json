{
  "name": "kanagadhara-sweets",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:api",
    "preview": "vite preview",
    "build:api": "tsc -p server/tsconfig.json",
    "dev:api": "npm run build:api && npm run start:api",
    "admin:local": "powershell -NoProfile -File scripts/start-admin-local.ps1",
    "start:api": "node server/dist/server/index.js",
    "test:api": "npm run build:api && node --test server/catalog.test.mjs server/adminSession.test.mjs",
    "test": "npm run test:api && node --test tests/saved-bag.test.mjs"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.82",
    "aos": "^2.3.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/aos": "^3.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
