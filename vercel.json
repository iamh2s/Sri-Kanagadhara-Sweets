{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/(.*)", "has": [{ "type": "query", "key": "q" }], "headers": { "X-Robots-Tag": "noindex, follow" }, "continue": true },
    { "src": "/(.*)", "has": [{ "type": "query", "key": "sort" }], "headers": { "X-Robots-Tag": "noindex, follow" }, "continue": true },
    { "src": "/(.*)", "has": [{ "type": "query", "key": "wishlist" }], "headers": { "X-Robots-Tag": "noindex, follow" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(?:admin(?:/.*)?|account(?:/(?:orders(?:/[^/]+)?|addresses|wishlist))?|cart|checkout|payment/status|order-status|track-order|orders/[^/]+/confirmation|search|maintenance|500)/?", "dest": "/private.html" },
    { "src": "/festival/[^/]+/?", "dest": "/festival-preorders/index.html" },
    { "src": "/(?!api(?:/|$)).*", "dest": "/404.html", "status": 404 }
  ]
}
